#!/usr/bin/env python

from pathlib import Path

injections = [
    ("asm", ";", []),
    ("javascript", "//", []),
    ("json", "//", []),
    ("nginx", "#", []),
    ("promql", "#", []),
    ("python", "#", []),
    ("query", ";;", []),
    ("river", "//", ["alloy"]),
    ("sh", "#", ["shell", "bash"]),
    ("sql", "--", []),
    ("typescript", "//", []),
    ("vcl", "//", []),
    ("vtc", "//", []),
    ("yaml", "#", ["yml"]),
]


def python_header():
    return """; extends

;; inspired by
;; https://github.com/DariusCorvus/tree-sitter-language-injection.nvim
"""


def python_generator(language: str, comment: str, alias: str):
    return rf"""
;; {language}: comment in string
(
  (string_content) @injection.content (#match? @injection.content "^\n*( )*{comment}( )*{alias}( )*\n")
  (#set! injection.language "{language}")
)

;; {language}: comment before string
(
  (comment) @_lang (#eq? @_lang "# {alias}")
  (expression_statement
    (assignment
      (string
        (string_content) @injection.content
        (#set! injection.language "{language}")
      )
    )
  )
)
"""


def yaml_header():
    return """; extends

;; for reference
;; https://github.com/nvim-treesitter/nvim-treesitter/blob/master/queries/yaml/injections.scm
"""


def yaml_generator(language: str, comment: str, alias: str):
    return rf"""
;; {language}: comment in string
(block_node
  (block_scalar) @injection.content (#match? @injection.content "^[\\|\\>]\n*( )*{comment}( ){alias}( )*\n")
  (#set! injection.language "{language}")
  (#offset! @injection.content 0 1 0 0)
)

;; {language}: comment before string
(block_mapping_pair
  (comment) @_lang (#eq? @_lang "# {alias}")
  (block_node
    (block_mapping
      (block_mapping_pair
        key: (flow_node) @_content
        value: (block_node
          (block_scalar) @injection.content
          (#set! injection.language "{language}")
          (#offset! @injection.content 0 1 0 0)
        )
      )
    )
  )
)
"""


def jsonnet_header():
    return """; extends
"""


# Positions a `// <lang>` marker comment can sit in front of, as a (prefix, suffix)
# pair wrapped around the string pattern. The comment is always the immediately
# preceding sibling of the outermost node listed here.
jsonnet_positions = [
    ("", ""),  # parenthesis, array element, second and later call args
    ("(args . ", ")"),  # first argument of a call
    ("(member (field ", "))"),  # object field value
    ("(member (objlocal (bind ", ")))"),  # object local
    ("(local_bind (bind ", "))"),  # top level local
]

# The string on its own, or as the left side of a `str % { ... }` format expression.
jsonnet_formats = [("", ""), ("(binary . ", ")")]


def jsonnet_value_alternation():
    string = "(string (string_content) @injection.content)"
    branches = [
        f"    {pos_open}{fmt_open}{string}{fmt_close}{pos_close}"
        for pos_open, pos_close in jsonnet_positions
        for fmt_open, fmt_close in jsonnet_formats
    ]
    return "[\n" + "\n".join(branches) + "\n  ]"


def jsonnet_generator(language: str, comment: str, alias: str):
    # A `|||-` text block keeps its chomp marker inside string_content, so the
    # marker has to be trimmed off the injected range with an offset. The two
    # regexes keep the plain and chomped variants mutually exclusive.
    return rf"""
;; {language}: comment in string
(
  (string
    (string_content) @injection.content
    (#match? @injection.content "^\n*( )*{comment}( )*{alias}( )*\n"))
  (#set! injection.language "{language}")
)

;; {language}: comment in chomped text block
(
  (string
    (string_content) @injection.content
    (#match? @injection.content "^-\n*( )*{comment}( )*{alias}( )*\n"))
  (#set! injection.language "{language}")
  (#offset! @injection.content 0 1 0 0)
)
"""


# Every "comment before value" pattern starts matching on the same (comment) node
# and fans out over jsonnet_value_alternation(), so one pattern per alias blows
# past the 256 in-progress match limit that vim.treesitter uses for injections and
# silently drops whole languages. Emitting one pattern per language instead, with
# the aliases folded into a single #any-of?, keeps the query inside the budget.
def jsonnet_extra(file):
    value = jsonnet_value_alternation()
    for language, _, aliases in injections:
        markers = " ".join(f'"// {a}"' for a in [language] + aliases)
        file.write(rf"""
;; {language}: comment before value
(
  (comment) @_lang (#any-of? @_lang {markers})
  .
  {value}
  (#not-match? @injection.content "^-")
  (#set! injection.language "{language}")
)

;; {language}: comment before chomped text block
(
  (comment) @_lang (#any-of? @_lang {markers})
  .
  {value}
  (#match? @injection.content "^-")
  (#set! injection.language "{language}")
  (#offset! @injection.content 0 1 0 0)
)
""")


def rust_header():
    return """; extends
"""


def rust_generator(language: str, comment: str, alias: str):
    return rf"""
;; {language}: comment in string
(
  (string_content) @injection.content (#match? @injection.content "^\n*( )*{comment}( )*{alias}( )*\n")
  (#set! injection.language "{language}")
)

;; {language}: comment before macro string (expression)
(
  (line_comment) @_lang (#eq? @_lang "// {alias}")
  .
  (expression_statement
    (macro_invocation
      (token_tree
        (raw_string_literal
          (string_content) @injection.content
        )
      )
    )
  )
  (#set! injection.language "{language}")
)

;; {language}: comment before macro string (let binding)
(
  (line_comment) @_lang (#eq? @_lang "// {alias}")
  .
  (let_declaration
    (macro_invocation
      (token_tree
        (raw_string_literal
          (string_content) @injection.content
        )
      )
    )
  )
  (#set! injection.language "{language}")
)

;; {language}: comment before macro string (inside token_tree)
(token_tree
  (line_comment) @_lang (#eq? @_lang "// {alias}")
  .
  (identifier)
  .
  (token_tree
    (raw_string_literal
      (string_content) @injection.content
    )
  )
  (#set! injection.language "{language}")
)
"""


def rust_macro_injection(language: str, macro_path: str, macro_names: list[str]):
    names_str = " ".join(f'"{n}"' for n in macro_names)
    parts = macro_path.rsplit("::", 1)
    result = ""

    if len(parts) == 2:
        path, _ = parts
        # macro_invocation: sqlx::query!("...")
        result += rf"""
;; {macro_path}! macros
(macro_invocation
  macro: (scoped_identifier
    path: (identifier) @_path (#eq? @_path "{path}")
    name: (identifier) @_name (#any-of? @_name {names_str})
  )
  (token_tree
    (raw_string_literal
      (string_content) @injection.content
    )
  )
  (#set! injection.language "{language}")
)
"""
        # call_expression with generics: sqlx::query_as::<T>("...")
        result += rf"""
;; {macro_path}::<T>() calls
(call_expression
  function: (generic_function
    function: (scoped_identifier
      path: (identifier) @_path (#eq? @_path "{path}")
      name: (identifier) @_name (#any-of? @_name {names_str})
    )
  )
  arguments: (arguments
    (raw_string_literal
      (string_content) @injection.content
    )
  )
  (#set! injection.language "{language}")
)
"""
    else:
        result += rf"""
;; {macro_path} macros
(macro_invocation
  macro: (identifier) @_name (#any-of? @_name {names_str})
  (token_tree
    (raw_string_literal
      (string_content) @injection.content
    )
  )
  (#set! injection.language "{language}")
)
"""

    return result


# Extra injections per language: callable returning a string of query content.
# Macro-based injections: (language, macro_path, macro_names)
# macro_path with "::" generates a scoped_identifier match,
# without "::" generates a plain identifier match.
def rust_extra(file):
    for language, macro_path, macro_names in [
        (
            "sql",
            "sqlx::query",
            [
                "query",
                "query_as",
                "query_scalar",
                "query_unchecked",
                "query_as_unchecked",
                "query_scalar_unchecked",
            ],
        ),
        ("asm", "asm_test", ["asm_test"]),
    ]:
        file.write(rust_macro_injection(language, macro_path, macro_names))


generators = {
    "python": (python_header, python_generator, None),
    "yaml": (yaml_header, yaml_generator, None),
    "jsonnet": (jsonnet_header, jsonnet_generator, jsonnet_extra),
    "rust": (rust_header, rust_generator, rust_extra),
}

for name, (header, gen, extra) in generators.items():
    Path(name).mkdir(exist_ok=True)
    with (Path(name) / "injections.scm").open("w") as file:
        file.write(header())
        for language, comment, aliases in injections:
            for alias in [language] + aliases:
                file.write(gen(language, comment, alias))
        if extra:
            extra(file)
