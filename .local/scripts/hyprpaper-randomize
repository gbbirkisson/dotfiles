#!/usr/bin/env bash

# listactive prints "<monitor>: <path>" per output, so strip the monitor prefix
CURRENT_WALL=$(hyprctl hyprpaper listactive | head -n1 | sed 's/^[^:]*: //')

# Get a random wallpaper that is not the current one
WALLPAPER=$(find "$WALLPAPERS" -type f ! -name "$(basename "$CURRENT_WALL")" | shuf -n 1)

# Apply the selected wallpaper
hyprctl hyprpaper wallpaper ,"$WALLPAPER"
