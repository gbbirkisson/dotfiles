#!/usr/bin/env bash

# Pick a power profile in wofi; the active one is marked with *.
current=$(powerprofilesctl get)

# --nr prints waybar JSON: 1 power-saver, 2 balanced, 3 performance, classed by profile.
if [ "$1" = "--nr" ]; then
  case "$current" in
  power-saver) nr=1 ;;
  balanced) nr=2 ;;
  performance) nr=3 ;;
  esac
  printf '{"text": "%s", "class": "%s", "tooltip": "%s"}\n' "$nr" "$current" "$current"
  exit
fi

# --auto follows the power supply: performance on AC, balanced on battery, power-saver below 20%.
if [ "$1" = "--auto" ]; then
  # One watcher per login, even if Hyprland restarts.
  exec 9>"$XDG_RUNTIME_DIR/hypr-script-power-profile.lock"
  flock -n 9 || exit
  upower_get() {
    gdbus call --system --dest org.freedesktop.UPower --object-path "$1" \
      --method org.freedesktop.DBus.Properties.Get "$2" "$3"
  }
  # Only set on target change, so manual picks survive battery ticks.
  last=
  follow() {
    if upower_get /org/freedesktop/UPower org.freedesktop.UPower OnBattery | grep -q true; then
      percentage=$(upower_get /org/freedesktop/UPower/devices/DisplayDevice org.freedesktop.UPower.Device Percentage | tr -dc '0-9.')
      if [ "${percentage%.*}" -lt 20 ]; then
        target=power-saver
      else
        target=balanced
      fi
    else
      target=performance
    fi
    [ "$target" = "$last" ] && return
    last=$target
    powerprofilesctl set "$target"
    pkill -RTMIN+8 -x waybar
  }
  follow
  gdbus monitor --system --dest org.freedesktop.UPower | while read -r line; do
    case "$line" in
    *OnBattery* | *Percentage*) follow ;;
    esac
  done
  exit
fi

for profile in power-saver balanced performance; do
  if [ "$profile" = "$current" ]; then
    echo "* $profile"
  else
    echo "  $profile"
  fi
done | wofi --dmenu --cache-file /dev/null --prompt profile | sed 's/^[* ]*//' | xargs -r powerprofilesctl set

# Refresh waybar's custom/power-profile module (its "signal" is 8).
pkill -RTMIN+8 -x waybar
