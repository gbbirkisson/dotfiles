#!/usr/bin/env bash

# Swap the active workspace with its neighbour and follow it. Workspace ids are
# changed in place, so both layouts survive. Hyprland refuses an id that is taken,
# so an occupied neighbour is parked on a temporary id during the swap.

set -euo pipefail

DIRECTION="${1:?usage: hypr-script-swap-workspace <-1|+1>}"

# Matches the ten workspaces bound in hyprland.lua
LOWEST=1
HIGHEST=10
PARKED=999999

CURRENT=$(hyprctl activeworkspace -j | jq -r '.id')

TARGET=$((CURRENT + DIRECTION))
if [ "$TARGET" -lt "$LOWEST" ] || [ "$TARGET" -gt "$HIGHEST" ]; then
  exit 0
fi

change_id() {
  echo "dispatch hl.dsp.workspace.change_id({ workspace = $1, id = $2 })"
}

if hyprctl workspaces -j | jq -e --argjson ws "$TARGET" 'any(.[]; .id == $ws)' >/dev/null; then
  DISPATCHES=(
    "$(change_id "$TARGET" "$PARKED")"
    "$(change_id "$CURRENT" "$TARGET")"
    "$(change_id "$PARKED" "$CURRENT")"
  )
else
  DISPATCHES=("$(change_id "$CURRENT" "$TARGET")")
fi

hyprctl --batch "$(
  IFS=';'
  echo "${DISPATCHES[*]}"
)"

# Waybar does not handle the changeworkspaceid event
pkill -SIGUSR2 -x waybar || true
