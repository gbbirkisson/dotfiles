#!/usr/bin/env bash

# Free disk space: prune podman, docker, mise, uv, rustup, npm, then offer to clean large cargo targets
# Usage: hd-prune [threshold-gb] (default: 1)

threshold=$((${1:-1} * 1024 * 1024 * 1024))

has() { command -v "$1" >/dev/null; }

df -h /

has podman && podman system prune -af
has docker && docker system prune -af
has mise && mise prune -y
has uv && uv cache prune
has npm && npm cache clean --force

if has rustup; then
  default=$(rustup default | cut -d' ' -f1)
  rustup toolchain list | cut -d' ' -f1 | grep -vx "$default" | xargs -r rustup toolchain uninstall
fi

if has fd && has cargo; then
  fd --hidden --no-ignore --prune --type d '^target$' ~/repos | while read -r target; do
    repo=${target%/target/}
    [ -f "$repo/Cargo.toml" ] || continue
    size=$(du -sb "$target" | cut -f1)
    ((size > threshold)) || continue
    read -rp "Clean $repo ($(numfmt --to=iec "$size"))? [y/N] " answer </dev/tty
    [ "$answer" = y ] && cargo clean --manifest-path "$repo/Cargo.toml"
  done
fi

df -h /
