{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
  ],
  semanticCommitType: 'fix',
  reviewersFromCodeOwners: true,
  dependencyDashboard: true,
  packageRules: [
    {
      matchDatasources: [
        'asdf',
      ],
      minimumReleaseAge: '3 days',
    },
    {
      allowedVersions: '!/v4.9.0$/',
      matchPackageNames: [
        '/regolith-desktop/',
      ],
    },
    {
      groupName: 'hyprland dependencies',
      groupSlug: 'hyprland-dep',
      matchPackageNames: [
        'hyprwm/**',
        '!hyprwm/hyprland',
      ],
    },
    {
      groupName: 'cargo crates',
      groupSlug: 'cargo',
      matchDatasources: [
        'crate',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Match versions that are tagged with comments',
      managerFilePatterns: [
        '/^.*.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>[^\\s]+)( packageName=(?<packageName>[^\\s]+))?( versioning=(?<versioning>[^\\s]+))?\\s*.*version:\\s(?<currentValue>[^\\s]+)',
      ],
    },
    {
      customType: 'regex',
      description: 'Match versions of cargo crates',
      datasourceTemplate: 'crate',
      versioningTemplate: 'semver',
      managerFilePatterns: [
        '/^.*.ya?ml$/',
      ],
      matchStrings: [
        'crate_name: (?<depName>[^\\s]+), version: (?<currentValue>[^\\s]+),',
      ],
    },
    {
      customType: 'regex',
      description: 'Match versions of lazy dependencies',
      datasourceTemplate: 'github-tags',
      managerFilePatterns: [
        '/^.*.lua$/',
      ],
      matchStrings: [
        "'(?<depName>[^\\s]+)',\\s*.*version\\s=\\s'(?<currentValue>[^\\s]+)',",
      ],
    },
    {
      "description": "mise github: and ubi: backends, taken from the owner/repo in the entry itself",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.tool-versions$/"
      ],
      "matchStrings": [
        "(?m)^(?:github|ubi):(?<packageName>[^\\s/]+/(?<depName>[^\\s/]+))[ \\t]+(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "description": "mise npm: backends",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.tool-versions$/"
      ],
      "matchStrings": [
        "(?m)^npm:(?<depName>[^\\s]+)[ \\t]+(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "description": "Anything else, annotated with a `# renovate:` comment on the line above",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.tool-versions$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>[^\\s]+)( packageName=(?<packageName>[^\\s]+))?( registryUrl=(?<registryUrl>[^\\s]+))?( versioning=(?<versioning>[^\\s]+))?( extractVersion=(?<extractVersion>[^\\s]+))?[ \\t\\r]*\\n[^\\s]+[ \\t]+(?<currentValue>[^\\s#]+)"
      ]
    },
  ],
}
